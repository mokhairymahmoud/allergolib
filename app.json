      "package": "fr.chunice.allergolib"
    },
    "extra": {
      "datasetManifestUrl": "https://pub-c34d809f85ce4fd6ad497eaeb7df5c62.r2.dev/datasets/latest/manifest.json",
      "eas": {
        "projectId": "2e7c6bb6-8a04-437d-865e-2daa1b81aae0"
      }
    },
    "owner": "eignspaces",
    "plugins": [
      "expo-status-bar",
      "expo-font",
      "expo-sharing",
      "expo-notifications",
      "./plugins/withSceneLifecycle"
    ]
  }
}
