    "expo-notifications": "~57.0.21",
    "expo-print": "~57.0.2",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@google/clasp": "^3.3.0",
    "@types/react": "~19.2.10",
    "google-auth-library": "^10.6.2",
