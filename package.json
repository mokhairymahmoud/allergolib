{
  "name": "allergolib",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "admin:clasp:deploy": "node ./scripts/run-admin-clasp.mjs deploy",
    "admin:clasp:link": "node ./scripts/setup-admin-clasp.mjs",
    "admin:clasp:login": "node ./scripts/run-admin-clasp.mjs login",
    "admin:clasp:open": "node ./scripts/run-admin-clasp.mjs open",
